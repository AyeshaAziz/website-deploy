    "dateOfBirth": { "label": "Date of birth" },
    "gender": { "label": "Gender" },
    "address": { "label": "Address", "placeholder": "Street address" },
    "city": { "label": "City", "placeholder": "City" },
    "country": { "label": "Country", "placeholder": "Country" },
    "occupation": { "label": "Occupation", "placeholder": "Your current occupation" },
