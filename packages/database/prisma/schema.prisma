generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CONTENT_EDITOR
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SectionType {
  HOME
  TEXT
  FEATURED_COURSES
  MULTIMEDIA
  FEATURED_RESOURCES
  CTA
}

// Editors only on Day 1. Students, teachers etc. arrive with the portals.
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  role         Role
  passwordHash String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  archivedAt   DateTime?
  auditLogs    AuditLog[]
}

model WebsitePage {
  id             String        @id @default(cuid())
  urlPath        String        @unique
  title          String
  status         PublishStatus @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  publishedAt    DateTime?
  publishedById  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sections       Section[]
}

model Section {
  id        String      @id @default(cuid())
  pageId    String
  page      WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      SectionType
  order     Int
  content   Json
  visible   Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([pageId, order])
}

// Fields are a starting point: validate with ITQA during discovery.
model Course {
  id          String        @id @default(cuid())
  urlPath     String        @unique
  title       String
  summary     String
  description String?
  imageUrl    String?
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime?
}

model Resource {
  id          String        @id @default(cuid())
  title       String
  url         String
  kind        String        @default("LINK") // LINK | YOUTUBE | PDF
  description String?
  status      PublishStatus @default(DRAFT)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  archivedAt  DateTime?
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}
